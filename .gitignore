# ==============================================================================
# JeevaDrishti - Comprehensive .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
key.json
*key*.json
secrets/
*credential*.json
*service_account*.json

# Database & SQLite Local State
*.db
*.sqlite
*.sqlite3
anaconda_projects/

# User Uploads, Outputs & Media Storage
uploads/
backend/uploads/
results/
reports/
*.pdf
*.log

# Large Datasets & Benchmark Imagery
/datasets/
/Micro-OD/
/data/
/dataset/
/sampled_dataset/
*.zip
*.tar
*.tar.gz
*.npz
# Only ignore images/ temp_data/ overlays/ plots/ at root level (not inside frontend/src)
/images/
/temp_data/
/overlays/
/plots/
# Never ignore frontend source files
!frontend/src/**

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
backend/venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.mypy_cache/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
.next/
.eslintcache
coverage/

# AI Models, Checkpoints & Large Weights
*.pth
*.pt
*.bin
*.onnx
*.safetensors
*.ckpt
models/
checkpoints/
huggingface/
.cache/

# IDE, OS & Temporary Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
