# ==============================================================================
# JeevaDrishti Backend Environment Configuration Example
# ==============================================================================

# Application Metadata & Runtime Environment
APP_NAME=JeevaDrishti API
APP_VERSION=1.0.0
# Set ENVIRONMENT to 'production' or 'development'
ENVIRONMENT=production
# Set DEBUG=false in production to disable trace logging and API debug modes
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database Configuration
# Local Development (SQLite):
# DATABASE_URL=sqlite:///./jeevadrishti.db
# Production (PostgreSQL):
DATABASE_URL=postgresql://jeevadrishti_user:secure_password@db:5432/jeevadrishti_prod

# CORS Security (Comma-separated trusted client origins, NO wildcards in production)
CORS_ORIGINS=https://app.jeevadrishti.org,http://localhost:5173

# Persistent File Storage & Upload Validation
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# JWT Authentication Security (MUST be >= 32 characters in production)
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI / SAM Object Proposal Configuration
# Path to downloaded ViT-H / ViT-L checkpoint file (mount as volume in Docker)
SAM_MODEL_PATH=/models/sam_vit_h_4b8939.pth
SAM_MODEL_TYPE=vit_h
# Max proposals evaluated during live interactive analysis (default: 15)
MAX_LIVE_CANDIDATES=15

# Vision-Language Model (VLM) Classification
VLM_PROVIDER=gemini
VLM_MODEL=gemini-2.5-flash
# Supply valid API key for live inference
VLM_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Micro-OD Benchmark & Research Evaluation Settings
# Leave blank to default to <repo_root>/datasets/Micro-OD
MICRO_OD_PATH=
MAX_BENCHMARK_CANDIDATES=200
BENCHMARK_IOU_THRESHOLD=0.50
