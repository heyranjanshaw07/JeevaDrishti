# ==============================================================================
# JeevaDrishti - Environment Variables Template
# ==============================================================================
# Copy this file to .env in your backend or root directory and fill in your values.
# NEVER commit .env or sensitive credentials to GitHub.
# ==============================================================================

# Application Metadata
APP_NAME=JeevaDrishti
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security & Authentication (Generate a strong 32+ char secret for production)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Local Development (SQLite): sqlite:///./jeevadrishti.db
# Production (PostgreSQL): postgresql://user:password@localhost:5432/jeevadrishti
DATABASE_URL=

# CORS Origins (Comma-separated trusted URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# AI / SAM Object Proposal Engine
# Path to downloaded ViT-H or ViT-L weights checkpoint
SAM_MODEL_PATH=
SAM_MODEL_TYPE=vit_h
MAX_LIVE_CANDIDATES=15

# Vision-Language Model (VLM) Configuration
VLM_PROVIDER=gemini
VLM_MODEL=gemini-2.5-flash
VLM_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Micro-OD Benchmark Settings
MICRO_OD_PATH=
MAX_BENCHMARK_CANDIDATES=200
BENCHMARK_IOU_THRESHOLD=0.50

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
